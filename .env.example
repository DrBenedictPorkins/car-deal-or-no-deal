# Copy to .env and edit. Every setting is optional — the defaults are local-only.

# --- storage -----------------------------------------------------------------
# DEALBENCH_DATA_DIR=./data

# --- server ------------------------------------------------------------------
# DEALBENCH_PORT=8756
# Binding off-loopback also requires DEALBENCH_API_TOKEN. Don't, unless you mean it.
# DEALBENCH_ALLOW_NON_LOOPBACK_BIND=false

# --- negotiation defaults (the buyer profile overrides these) ----------------
# DEALBENCH_FOLLOW_UP_AFTER_HOURS=48
# DEALBENCH_NO_RESPONSE_AFTER_DAYS=7

# --- ingestion ---------------------------------------------------------------
# UNIT (fixtures only) | REPLAY (.eml files) | GMAIL (the real API).
# Business logic is identical in all three; only the source differs.
# DEALBENCH_INGEST_MODE=UNIT

# Gmail. OAuth only — this app has no password field anywhere.
# Download a Desktop-app OAuth client from Google Cloud and point at the JSON.
# DEALBENCH_GMAIL_CLIENT_SECRET_FILE=~/dealbench-oauth-client.json
# DEALBENCH_GMAIL_ACCOUNT=dealbench.test.001@gmail.com
# Bound the first import so it cannot hoover up an entire mailbox.
# DEALBENCH_GMAIL_IMPORT_QUERY=subject:dealbench-test
# DEALBENCH_GMAIL_IMPORT_MAX_MESSAGES=2000
# Writes fixture messages into a mailbox (gmail.insert). Dedicated test accounts only.
# DEALBENCH_GMAIL_ALLOW_INSERT=false

# --- outbound safety ----------------------------------------------------------
# Three independent locks. All must be open before anything is sent: the transport
# must be enabled, safe mode must permit the recipient, and a human must have
# approved the specific draft.
# DEALBENCH_SEND_ENABLED=false
# DEALBENCH_SEND_SAFE_MODE=true
# DEALBENCH_SEND_ALLOWLIST=["dealbench.test.001@gmail.com"]

# --- LLM ---------------------------------------------------------------------
# Off by default: with llm_enabled=false nothing leaves this machine, whatever
# else is configured here.
# DEALBENCH_LLM_ENABLED=false
# DEALBENCH_LLM_PROVIDER=null
# DEALBENCH_LLM_MODEL=
# Storing prompts means storing dealer correspondence twice. Off by default.
# DEALBENCH_LLM_STORE_PAYLOADS=false
