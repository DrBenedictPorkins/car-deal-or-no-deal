# Data — never commit negotiation data, tokens, or blobs
data/
*.sqlite
*.sqlite3
*.db

# Real correspondence never enters the repository. The golden fixtures are
# sanitized reconstructions and are the one exception.
backend/tests/fixtures/corpus/
*.eml
*.mbox
!backend/tests/fixtures/golden/*.eml
# Re-identification key produced by the sanitizer. Never commit this.
mapping.private.json

# Secrets
.env
.env.*
!.env.example
client_secret*.json
credentials.json
token.json

